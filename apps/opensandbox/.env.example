OPENSANDBOX_DOMAIN=127.0.0.1:18080
OPENSANDBOX_API_KEY=

# 2-storage-host：服务端宿主机目录，需加入 config.toml 的 [storage].allowed_host_paths
HOST_VOLUME_PATH=

# k8s/2-storage-s3-pvc（可选）
S3_STORAGE_CLASS=oss-aliyun-s3
S3_PVC_NAME=opensandbox-object-data

# k8s/2-storage-oss
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- Jev (TypeSafe System One), both required ----
# https://docs.typesafe.ai/api
TYPESAFE_API_KEY=
# The API is region-restricted (HTTP 451 without a proxy)
HTTPS_PROXY=http://127.0.0.1:7890
# Pin the Jev version; upgrade only after replaying decisions.jsonl
# JEV_MODEL=jev-1.13.0
# Per-decision timeout. Jev sits on the hot path of every gated tool call, keep it short.
# JEV_TIMEOUT_MS=8000

# ---- LLM for the Pi agent: pi-ai's built-in DeepSeek provider, required ----
DEEPSEEK_API_KEY=

# ---- Harness ----
# Where decisions are appended (one JSON object per line, redacted)
# DECISION_LOG=decisions.jsonl

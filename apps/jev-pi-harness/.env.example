# ---- Jev (TypeSafe System One) ----
# Required for online runs: https://docs.typesafe.ai/api
TYPESAFE_API_KEY=
# Pin the Jev version; upgrade only after replaying decisions.jsonl
# JEV_MODEL=jev-1.13.0
# Per-decision timeout. Jev sits on the hot path of every gated tool call, keep it short.
# JEV_TIMEOUT_MS=8000
# The API is region-restricted; if it returns 451, route requests through a proxy
# HTTPS_PROXY=http://127.0.0.1:7890

# ---- LLM used by the Pi agent (any OpenAI-compatible endpoint) ----
# Falls back to DEEPSEEK_API_KEY when LLM_API_KEY is empty
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_FAST_MODEL=deepseek-v4-flash
# LLM_POWERFUL_MODEL=deepseek-v4-pro

# ---- Harness ----
# Where decisions are appended (one JSON object per line, redacted)
# DECISION_LOG=decisions.jsonl

# Keep credentials separate from the structured extension configuration.
OPENSANDBOX_API_KEY=

# Replace the image with one that your OpenSandbox deployment can pull.
# Set exactly one of PI_OPENSANDBOX_CONFIG or PI_OPENSANDBOX_CONFIG_FILE.
#
# Option 1: Keep a small configuration inline in this .env file.
PI_OPENSANDBOX_CONFIG='{"sandboxConfig":{"domain":"http://127.0.0.1:18080","image":"<your-sandbox-image>","timeoutSeconds":600,"lifecycle":{"onSessionShutdown":"kill"}}}'

# Option 2: For a larger configuration, comment out PI_OPENSANDBOX_CONFIG above
# and uncomment this absolute path:
# PI_OPENSANDBOX_CONFIG_FILE=/absolute/path/to/opensandbox.json
#
# The referenced opensandbox.json file must contain a JSON object using the
# PiOpenSandboxOptions shape. For example:
#
# {
#   "sandboxConfig": {
#     "domain": "http://127.0.0.1:18080",
#     "image": "<your-sandbox-image>",
#     "timeoutSeconds": 600,
#     "lifecycle": {
#       "onSessionShutdown": "kill"
#     }
#   },
#   "skills": [
#     {
#       "sourceDir": "/absolute/path/to/a/local/skill"
#     }
#   ],
#   "sharedSkillRoot": "/tmp/piworker/tasks/<task-id>/.agents/skills",
#   "skillSyncLimits": {
#     "maxFiles": 10000,
#     "maxFileBytes": 8388608,
#     "maxTotalBytes": 134217728
#   },
#   "verifyUploadedSkills": true
# }

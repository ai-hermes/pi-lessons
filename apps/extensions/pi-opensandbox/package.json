{
  "name": "@ai-hermes/pi-opensandbox",
  "version": "0.1.0",
  "description": "Run Pi coding-agent tools in a remote OpenSandbox sandbox",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-hermes/pi-lessons.git",
    "directory": "apps/extensions/pi-opensandbox"
  },
  "homepage": "https://github.com/ai-hermes/pi-lessons/tree/main/apps/extensions/pi-opensandbox#readme",
  "bugs": {
    "url": "https://github.com/ai-hermes/pi-lessons/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "opensandbox",
    "remote-sandbox"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    ".env.example",
    "src",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.11",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.0"
  }
}

{
  "name": "pi-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"pnpm server:dev\" \"pnpm web:dev\"",
    "web:dev": "vite",
    "server:dev": "tsx --watch --tsconfig tsconfig.node.json --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@hono/node-server": "^1.19.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.3",
    "hono-pino": "^0.10.3",
    "lucide-react": "^0.468.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "oxlint": "^1.79.0",
    "pino-pretty": "^13.1.3",
    "react-grab": "^0.1.37",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}

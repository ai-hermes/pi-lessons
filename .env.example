DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash



VOLCENGINE_API_KEY=your_volcengine_api_key
VOLCENGINE_ACCESS_KEY_ID=your_volcengine_access_key_id
VOLCENGINE_SECRET_ACCESS_KEY=your_volcengine_secret_access_key


# Copy to .env and fill your own values. Never commit .env.

# Optional default model selector in the format provider/model-id.
# Example: anthropic/claude-opus-4-5
PI_MODEL=

# Optional DataAgent model selector in the same provider/model-id format.
DATA_AGENT_MODEL=

# Optional custom provider model selector (must exist in models.json)
PI_CUSTOM_PROVIDER=
PI_CUSTOM_MODEL=

# Optional Pi Chat local data directory, idle runtime TTL, and API port.
PI_CHAT_DATA_DIR=
PI_CHAT_IDLE_TTL_MS=300000
PI_CHAT_PORT=4328

# Common provider credentials
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
